# Copy to .env and fill in. .env is git-ignored; never put keys in code or URLs.

# --- Database (docker compose up -d) -------------------------------------------
DATABASE_URL=postgresql+psycopg://trustagent:trustagent@localhost:5433/trustagent
TEST_DATABASE_URL=postgresql+psycopg://trustagent:trustagent@localhost:5433/trustagent_test
# Created by scripts/setup_eval_db.py; the evaluation resets it before every case.
EVAL_DATABASE_URL=postgresql+psycopg://trustagent:trustagent@localhost:5433/trustagent_eval

# --- Generator model --------------------------------------------------------------
# Providers: gemini | groq | openai | anthropic  (factory supports all four;
# only gemini and groq have been run end-to-end, see README "Limitations")
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# --- LLM-as-judge (must be a different provider from the generator) -------------
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-120b

# --- API keys ---------------------------------------------------------------------
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings: ONE model for ingestion and querying -----------------------------
# Changing either value needs a new migration for the vector column and a re-ingest.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Optional: LangSmith tracing ----------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=trustagent
